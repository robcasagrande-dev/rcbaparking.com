---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  schema?: any;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://rcbaparking.com';

const title = Astro.props.title || t('meta.title');
const description = Astro.props.description || t('meta.desc');
const keywords = Astro.props.keywords || t('meta.keywords');

// Build canonical URL cleanly
const rawPathname = Astro.url.pathname;
const cleanPathname = rawPathname.endsWith('/') ? rawPathname : `${rawPathname}/`;
const canonicalURL = new URL(cleanPathname, siteUrl).toString();

// Build alternate links for all 5 languages + x-default
const alternates = [
  { lang: 'es', href: `${siteUrl}/` },
  { lang: 'en', href: `${siteUrl}/en/` },
  { lang: 'it', href: `${siteUrl}/it/` },
  { lang: 'fr', href: `${siteUrl}/fr/` },
  { lang: 'de', href: `${siteUrl}/de/` },
  { lang: 'x-default', href: `${siteUrl}/` }
];

// JSON-LD Schemas for Search Engine Optimization
